# fortuna-api in the `development` environment: the VPS, on demand (started only when used), deployed
# by yggdrasil's Jenkins on every push to `develop`. The copy lives at
# /etc/yggdrasil/development/fortuna-api.env on the VPS; never commit it. Every secret here is
# development's own, never production's.

# The host names Traefik routes to this API: its own, and the web UI's, under which it also serves
# its /api/ routes (same origin for the browser).
PUBLIC_HOST=fortuna-api-dev.example.com
UI_HOST=fortuna-dev.example.com

ASPNETCORE_ENVIRONMENT=Development
# Database. Preferred: uncomment FORTUNA_DATA_CONNECTIONSTRING and set one complete connection
# string; the DB_* variables are then ignored and can be removed. Without it, docker-compose.yml
# assembles the connection string from DB_* (DB_USER and DB_PASSWORD are then required).
# FORTUNA_DATA_CONNECTIONSTRING=Host=host.docker.internal;Port=5432;Database=fortuna_development;Username=fortuna_development;Password=replace-me;Search Path=fortuna
# PostgreSQL on the VPS itself; the compose file maps host.docker.internal to the host.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=fortuna_development
DB_USER=fortuna_development
DB_PASSWORD=replace-me
DB_SEARCH_PATH=fortuna
# Ignored when yggdrasil deploys: Traefik reaches the container, so it publishes no host port, and
# it names the Compose project fortuna-api-development (COMPOSE_PROJECT_NAME is ignored too).
API_PORT=127.0.0.1:8080
FORTUNA_RUN_MIGRATIONS=true
FORTUNA_STORAGE_PROVIDER=Filesystem
FORTUNA_STORAGE_PATH=/app/attachments
FORTUNA_UPLOAD_MAX_BYTES=10485760
FORTUNA_UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png
FORTUNA_EXCEL_IMPORT_MAX_BYTES=10485760
FORTUNA_PDF_IMPORT_MAX_BYTES=20971520
FORTUNA_LOG_DIRECTORY=/app/logs
FORTUNA_JOB_QUEUE_CAPACITY=256
FORTUNA_PAGE_SIZE_MAX=100
FORTUNA_REPORT_MAX_RANGE_DAYS=366
FORTUNA_REPORT_KEY_TTL_MINUTES=15
FORTUNA_PROJECTION_MAX_HORIZON_DAYS=366
FORTUNA_EXPORT_SYNC_THRESHOLD_ROWS=1000
FORTUNA_EXPORT_RETENTION_HOURS=24
FORTUNA_HEALTH_JOB_MAX_PENDING_SECONDS=300
FORTUNA_TRANSACTION_MAX_TAGS=50
FORTUNA_RECONCILIATION_AMOUNT_TOLERANCE=0.01
FORTUNA_RECONCILIATION_DATE_TOLERANCE_DAYS=1
FORTUNA_METRICS_PORT=9464
FORTUNA_AUTH_TOKEN_ISSUER=heimdall
FORTUNA_AUTH_TOKEN_AUDIENCE=fortuna
FORTUNA_AUTH_TOKEN_EXPIRATION_IN_SECONDS=3600
# Development's heimdall-api. Must be HTTPS, so it is the public host rather than the edge network.
FORTUNA_HEIMDALL_BASE_URL=https://heimdall-api-dev.example.com/
# Where this environment's heimdall-api publishes its ES256 public keys, over the edge network. Plain
# HTTP is fine there: the keys are public, and Fortuna refetches them at most once a minute.
FORTUNA_HEIMDALL_JWKS_URL=http://heimdall-api.development:8080/.well-known/jwks.json
# Fortuna's own key for its local-account tokens; it never leaves Fortuna. openssl rand -hex 48.
# At least 32 characters, or startup is rejected.
FORTUNA_LOCAL_TOKEN_SECRET=
# The issuer of those tokens. It must differ from FORTUNA_AUTH_TOKEN_ISSUER.
FORTUNA_LOCAL_TOKEN_ISSUER=fortuna-local
# The fortuna scope's id in development's Heimdall (each environment's Heimdall has its own).
FORTUNA_HEIMDALL_SCOPE_ID=00000000-0000-0000-0000-000000000001
# Optional. One of development Heimdall's HEIMDALL_TRUSTED_CALLER_KEYS (at least 32 visible ASCII
# characters, no spaces or commas; startup rejects anything else). Set, each request to Heimdall names the end
# user's address, so Heimdall's anonymous auth limit counts per user instead of one shared bucket for
# this whole instance. List the reverse proxy in FORTUNA_FORWARDED_KNOWN_PROXIES/_NETWORKS so that
# address is the user's. Leave it empty and the shared bucket remains. A secret: never commit the real
# value.
FORTUNA_HEIMDALL_CALLER_KEY=
FORTUNA_DEFAULT_DISPLAY_CURRENCY=BRL
FORTUNA_LOCALE=pt-BR
FORTUNA_LOCAL_AUTH_ENABLED=false
FORTUNA_LOCAL_AUTH_RECOVERY_CODE_COUNT=10
FORTUNA_CONSENT_EXTERNAL_PROCESSING_VERSION=1.0
FORTUNA_PLUGGY_CLIENT_ID=
FORTUNA_PLUGGY_CLIENT_SECRET=
FORTUNA_PLUGGY_BASE_URL=https://api.pluggy.ai/
FORTUNA_RATES_SOURCE_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata/
FORTUNA_RATES_SYNC_CRON=0 18 * * 1-5
FORTUNA_RATES_CURRENCIES=BRL,USD,EUR,GBP
# Reverse proxies whose X-Forwarded-For/-Proto headers are trusted (CIDR networks, IP addresses).
# They decide which client IP address the rate limiter uses and the request log records. Traefik
# runs in a container on the shared `edge` network, so trust the Docker networks.
FORTUNA_FORWARDED_KNOWN_NETWORKS=172.16.0.0/12
FORTUNA_FORWARDED_KNOWN_PROXIES=
