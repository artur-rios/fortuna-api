ASPNETCORE_ENVIRONMENT=Development
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=fortuna
DB_USER=fortuna
DB_PASSWORD=replace-me
DB_SEARCH_PATH=fortuna
API_PORT=8080
FORTUNA_STORAGE_PROVIDER=Filesystem
FORTUNA_STORAGE_PATH=/app/attachments
FORTUNA_LOG_DIRECTORY=/app/logs
FORTUNA_PAGE_SIZE_MAX=100
FORTUNA_RECONCILIATION_AMOUNT_TOLERANCE=0.01
FORTUNA_RECONCILIATION_DATE_TOLERANCE_DAYS=1
FORTUNA_AUTH_TOKEN_SECRET=replace-me-with-the-heimdall-signing-secret
FORTUNA_AUTH_TOKEN_ISSUER=heimdall
FORTUNA_AUTH_TOKEN_AUDIENCE=fortuna
FORTUNA_AUTH_TOKEN_EXPIRATION_IN_SECONDS=3600
FORTUNA_DEFAULT_DISPLAY_CURRENCY=BRL
FORTUNA_LOCALE=pt-BR
FORTUNA_LOCAL_AUTH_ENABLED=true
FORTUNA_LOCAL_AUTH_RECOVERY_CODE_COUNT=10
# PTAX synchronization is intentionally unconfigured for an offline desktop installation.
FORTUNA_RATES_SOURCE_BASE_URL=
FORTUNA_RATES_SYNC_CRON=
FORTUNA_RATES_CURRENCIES=
