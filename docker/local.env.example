# fortuna-api in the `local` environment: the developer's Windows machine, on Docker Desktop, against
# the PostgreSQL installed on Windows. Copy to docker/local.env (gitignored) and run
#
#     docker compose --env-file docker/local.env up -d --build
#
# The API is then at http://localhost:8083 (heimdall-api keeps 8080). yggdrasil can deploy the same
# file instead (`scripts/deploy.sh local fortuna-api <this checkout> <version>`, with the copy at
# $YGG_SECRETS_DIR/local/fortuna-api.env).
ASPNETCORE_ENVIRONMENT=Development
# Database. Preferred: uncomment FORTUNA_DATA_CONNECTIONSTRING and set one complete connection
# string; the DB_* variables are then ignored and can be removed. Without it, docker-compose.yml
# assembles the connection string from DB_* (DB_USER and DB_PASSWORD are then required).
# FORTUNA_DATA_CONNECTIONSTRING=Host=host.docker.internal;Port=5432;Database=fortuna_local;Username=fortuna_local;Password=replace-me;Search Path=fortuna
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=fortuna_local
DB_USER=fortuna_local
DB_PASSWORD=replace-me
DB_SEARCH_PATH=fortuna
# Published on every interface, so a phone on the same network can reach it; write
# 127.0.0.1:8083 to keep it on this machine only.
API_PORT=8083
FORTUNA_RUN_MIGRATIONS=true
FORTUNA_STORAGE_PROVIDER=Filesystem
FORTUNA_STORAGE_PATH=/app/attachments
FORTUNA_UPLOAD_MAX_BYTES=10485760
FORTUNA_UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png
FORTUNA_EXCEL_IMPORT_MAX_BYTES=10485760
FORTUNA_PDF_IMPORT_MAX_BYTES=20971520
FORTUNA_LOG_DIRECTORY=/app/logs
FORTUNA_JOB_QUEUE_CAPACITY=256
FORTUNA_PAGE_SIZE_MAX=100
FORTUNA_REPORT_MAX_RANGE_DAYS=366
FORTUNA_REPORT_KEY_TTL_MINUTES=15
FORTUNA_PROJECTION_MAX_HORIZON_DAYS=366
FORTUNA_EXPORT_SYNC_THRESHOLD_ROWS=1000
FORTUNA_EXPORT_RETENTION_HOURS=24
FORTUNA_HEALTH_JOB_MAX_PENDING_SECONDS=300
FORTUNA_TRANSACTION_MAX_TAGS=50
FORTUNA_RECONCILIATION_AMOUNT_TOLERANCE=0.01
FORTUNA_RECONCILIATION_DATE_TOLERANCE_DAYS=1
# Metrics stay on the private listener; set 0 to disable the exporter.
FORTUNA_METRICS_PORT=9464
# At least 32 characters (HS256 key size); startup rejects a shorter secret.
FORTUNA_AUTH_TOKEN_SECRET=replace-me-with-the-heimdall-signing-secret
FORTUNA_AUTH_TOKEN_SECRET_PREVIOUS=
FORTUNA_AUTH_TOKEN_ISSUER=heimdall
FORTUNA_AUTH_TOKEN_AUDIENCE=fortuna
FORTUNA_AUTH_TOKEN_EXPIRATION_IN_SECONDS=3600
# Required at startup, and it must be HTTPS, so it cannot be the local heimdall-api
# (http://localhost:8080). Unused while local signs in with Fortuna's own local account
# (FORTUNA_LOCAL_AUTH_ENABLED=true). To sign in through Heimdall instead, point it at development's
# heimdall-api and use development's signing secret above.
FORTUNA_HEIMDALL_BASE_URL=https://heimdall-api-dev.example.com/
FORTUNA_HEIMDALL_SCOPE_ID=00000000-0000-0000-0000-000000000001
FORTUNA_DEFAULT_DISPLAY_CURRENCY=BRL
FORTUNA_LOCALE=pt-BR
FORTUNA_LOCAL_AUTH_ENABLED=true
FORTUNA_LOCAL_AUTH_RECOVERY_CODE_COUNT=10
FORTUNA_CONSENT_EXTERNAL_PROCESSING_VERSION=1.0
# Network-backed ingestion is unconfigured locally: it is off while local authentication is on.
FORTUNA_PLUGGY_CLIENT_ID=
FORTUNA_PLUGGY_CLIENT_SECRET=
FORTUNA_PLUGGY_BASE_URL=
# PTAX synchronization is unconfigured locally; rates can be recorded by hand.
FORTUNA_RATES_SOURCE_BASE_URL=
FORTUNA_RATES_SYNC_CRON=
FORTUNA_RATES_CURRENCIES=
# No reverse proxy in front of a local API.
FORTUNA_FORWARDED_KNOWN_NETWORKS=
FORTUNA_FORWARDED_KNOWN_PROXIES=
