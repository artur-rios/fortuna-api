# fortuna-api in the `homologation` environment: the VPS, on demand (started only when used),
# deployed by yggdrasil's Jenkins on every push of a release/x.y.z branch. The copy lives at
# /etc/yggdrasil/homologation/fortuna-api.env on the VPS; never commit it. Configured like
# production, with homologation's own database, bucket and secrets.

# The host names Traefik routes to this API: its own, and the web UI's, under which it also serves
# its /api/ routes (same origin for the browser).
PUBLIC_HOST=fortuna-api-hml.example.com
UI_HOST=fortuna-hml.example.com

# Production, like production: the API treats every other ASP.NET environment as a debugging one
# (Swagger UI, detailed errors), which homologation must not be.
ASPNETCORE_ENVIRONMENT=Production
# Database. Preferred: uncomment FORTUNA_DATA_CONNECTIONSTRING and set one complete connection
# string; the DB_* variables are then ignored and can be removed. Without it, docker-compose.yml
# assembles the connection string from DB_* (DB_USER and DB_PASSWORD are then required).
# FORTUNA_DATA_CONNECTIONSTRING=Host=host.docker.internal;Port=5432;Database=fortuna_homologation;Username=fortuna_homologation;Password=replace-me;Search Path=fortuna
# PostgreSQL on the VPS itself; the compose file maps host.docker.internal to the host.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=fortuna_homologation
DB_USER=fortuna_homologation
DB_PASSWORD=replace-me
DB_SEARCH_PATH=fortuna
# A database on another machine: set DB_HOST to it and verify its certificate. VerifyFull checks the
# server certificate chain and host name against Root Certificate; mount that CA file into the
# container (for example with a compose override) at the path given.
# DB_CONNECTION_EXTRA=SSL Mode=VerifyFull;Root Certificate=/app/certs/postgres-ca.crt
# Ignored when yggdrasil deploys: Traefik reaches the container, so it publishes no host port, and
# it names the Compose project fortuna-api-homologation (COMPOSE_PROJECT_NAME is ignored too).
API_PORT=127.0.0.1:8080
FORTUNA_RUN_MIGRATIONS=true
FORTUNA_STORAGE_PROVIDER=S3
FORTUNA_STORAGE_S3_ENDPOINT=https://replace-me
FORTUNA_STORAGE_S3_BUCKET=fortuna-homologation
FORTUNA_STORAGE_S3_ACCESS_KEY=replace-me
FORTUNA_STORAGE_S3_SECRET_KEY=replace-me
FORTUNA_UPLOAD_MAX_BYTES=10485760
FORTUNA_UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png
FORTUNA_EXCEL_IMPORT_MAX_BYTES=10485760
FORTUNA_PDF_IMPORT_MAX_BYTES=20971520
FORTUNA_LOG_DIRECTORY=/app/logs
FORTUNA_JOB_QUEUE_CAPACITY=256
FORTUNA_PAGE_SIZE_MAX=100
FORTUNA_REPORT_MAX_RANGE_DAYS=366
FORTUNA_REPORT_KEY_TTL_MINUTES=15
FORTUNA_PROJECTION_MAX_HORIZON_DAYS=366
FORTUNA_EXPORT_SYNC_THRESHOLD_ROWS=1000
FORTUNA_EXPORT_RETENTION_HOURS=24
FORTUNA_HEALTH_JOB_MAX_PENDING_SECONDS=300
FORTUNA_TRANSACTION_MAX_TAGS=50
FORTUNA_RECONCILIATION_AMOUNT_TOLERANCE=0.01
FORTUNA_RECONCILIATION_DATE_TOLERANCE_DAYS=1
FORTUNA_METRICS_PORT=9464
# At least 32 characters (HS256 key size); startup rejects a shorter secret.
# Must equal homologation heimdall-api's signing secret.
FORTUNA_AUTH_TOKEN_SECRET=replace-me-with-the-heimdall-signing-secret
FORTUNA_AUTH_TOKEN_SECRET_PREVIOUS=
FORTUNA_AUTH_TOKEN_ISSUER=heimdall
FORTUNA_AUTH_TOKEN_AUDIENCE=fortuna
FORTUNA_AUTH_TOKEN_EXPIRATION_IN_SECONDS=3600
# Homologation's heimdall-api. Must be HTTPS, so it is the public host rather than the edge network.
FORTUNA_HEIMDALL_BASE_URL=https://heimdall-api-hml.example.com/
# The fortuna scope's id in homologation's Heimdall (each environment's Heimdall has its own).
FORTUNA_HEIMDALL_SCOPE_ID=00000000-0000-0000-0000-000000000001
FORTUNA_DEFAULT_DISPLAY_CURRENCY=BRL
FORTUNA_LOCALE=pt-BR
FORTUNA_LOCAL_AUTH_ENABLED=false
FORTUNA_LOCAL_AUTH_RECOVERY_CODE_COUNT=10
FORTUNA_CONSENT_EXTERNAL_PROCESSING_VERSION=1.0
FORTUNA_PLUGGY_CLIENT_ID=replace-me
FORTUNA_PLUGGY_CLIENT_SECRET=replace-me
FORTUNA_PLUGGY_BASE_URL=https://api.pluggy.ai/
FORTUNA_RATES_SOURCE_BASE_URL=https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata/
FORTUNA_RATES_SYNC_CRON=0 18 * * 1-5
FORTUNA_RATES_CURRENCIES=BRL,USD,EUR,GBP
# Reverse proxies whose X-Forwarded-For/-Proto headers are trusted (comma-separated CIDR
# networks and/or IP addresses). Set the proxy's network so rate limiting and the request log,
# which records every caller's IP address, see real clients; loopback is always trusted. Traefik
# runs in a container on the shared `edge` network, so trust the Docker networks.
FORTUNA_FORWARDED_KNOWN_NETWORKS=172.16.0.0/12
FORTUNA_FORWARDED_KNOWN_PROXIES=
