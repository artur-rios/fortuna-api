# Tracked template only. Copy to .env.local and replace placeholders when running from source.
FORTUNA_DATA_CONNECTIONSTRING=Host=localhost;Port=5432;Database=fortuna;Username=postgres;Password=replace-me;Search Path=fortuna
FORTUNA_DATA_DATABASETYPE=PostgreSql
FORTUNA_STORAGE_PROVIDER=Filesystem
FORTUNA_STORAGE_PATH=./attachments
FORTUNA_LOG_DIRECTORY=./logs
FORTUNA_JOB_QUEUE_CAPACITY=256
FORTUNA_RUN_MIGRATIONS=true
